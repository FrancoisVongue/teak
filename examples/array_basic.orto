// Basic Array: создаём регион, выделяем в нём массив, читаем/пишем.
// Регион — это owned arena. Array — копируемая ручка в буфер региона.
// Когда регион уходит из scope, free buffer одной операцией.
fn main() -> int {
    let r = region(1024);              // одна арена 1 KB
    let a = array(r, 4, 0);            // массив на 4 int в r, все 0
    a[0] := 1;
    a[1] := 2;
    a[2] := 3;
    a[3] := 4;
    a[0] + a[1] + a[2] + a[3] + len(a)
    // 1 + 2 + 3 + 4 + 4 = 14
    // scope-exit: r освобождает свой buffer (один free).
}
