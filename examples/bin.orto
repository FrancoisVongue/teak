// std::bin — read/write multi-byte integers from/to Ref[byte].
//
// Both endiannesses. Native serialization is just one of them; the
// caller picks. Reads go through Ref indexing, so each byte access is
// gen- and bounds-checked (an out-of-range offset aborts). For the
// unchecked *byte version, see std::raw.
// Use this for netlink, sockets, file formats, anything binary.

// ---------- 16-bit ----------

fn read_u16_le(buf: Ref[byte], off: int) -> int {
    to_int(buf[off]) + to_int(buf[off + 1]) * 256
}

fn read_u16_be(buf: Ref[byte], off: int) -> int {
    to_int(buf[off]) * 256 + to_int(buf[off + 1])
}

fn write_u16_le(buf: Ref[byte], off: int, v: int) -> int {
    buf[off]     := to_byte(v % 256);
    buf[off + 1] := to_byte((v / 256) % 256);
    0
}

fn write_u16_be(buf: Ref[byte], off: int, v: int) -> int {
    buf[off]     := to_byte((v / 256) % 256);
    buf[off + 1] := to_byte(v % 256);
    0
}

// ---------- 32-bit ----------

fn read_u32_le(buf: Ref[byte], off: int) -> int {
    to_int(buf[off])
    + to_int(buf[off + 1]) * 256
    + to_int(buf[off + 2]) * 65536
    + to_int(buf[off + 3]) * 16777216
}

fn read_u32_be(buf: Ref[byte], off: int) -> int {
    to_int(buf[off]) * 16777216
    + to_int(buf[off + 1]) * 65536
    + to_int(buf[off + 2]) * 256
    + to_int(buf[off + 3])
}

fn write_u32_le(buf: Ref[byte], off: int, v: int) -> int {
    buf[off]     := to_byte(v % 256);
    buf[off + 1] := to_byte((v / 256) % 256);
    buf[off + 2] := to_byte((v / 65536) % 256);
    buf[off + 3] := to_byte((v / 16777216) % 256);
    0
}

fn write_u32_be(buf: Ref[byte], off: int, v: int) -> int {
    buf[off]     := to_byte((v / 16777216) % 256);
    buf[off + 1] := to_byte((v / 65536) % 256);
    buf[off + 2] := to_byte((v / 256) % 256);
    buf[off + 3] := to_byte(v % 256);
    0
}

// ---------- 64-bit ----------
//
// u64 returns/takes `u64`, NOT `int`: a full u64 (bit 63 set) does not
// fit in signed i64, so we assemble in the u64 type with shifts/masks
// (unsigned wrap is defined). u16/u32 stay `int` only because they fit.

fn read_u64_le(buf: Ref[byte], off: int) -> u64 {
    to_u64(to_int(buf[off]))
    | (to_u64(to_int(buf[off + 1])) << 8)
    | (to_u64(to_int(buf[off + 2])) << 16)
    | (to_u64(to_int(buf[off + 3])) << 24)
    | (to_u64(to_int(buf[off + 4])) << 32)
    | (to_u64(to_int(buf[off + 5])) << 40)
    | (to_u64(to_int(buf[off + 6])) << 48)
    | (to_u64(to_int(buf[off + 7])) << 56)
}

fn read_u64_be(buf: Ref[byte], off: int) -> u64 {
    (to_u64(to_int(buf[off])) << 56)
    | (to_u64(to_int(buf[off + 1])) << 48)
    | (to_u64(to_int(buf[off + 2])) << 40)
    | (to_u64(to_int(buf[off + 3])) << 32)
    | (to_u64(to_int(buf[off + 4])) << 24)
    | (to_u64(to_int(buf[off + 5])) << 16)
    | (to_u64(to_int(buf[off + 6])) << 8)
    | to_u64(to_int(buf[off + 7]))
}

fn write_u64_le(buf: Ref[byte], off: int, v: u64) -> int {
    buf[off]     := to_byte(to_int(v & 255));
    buf[off + 1] := to_byte(to_int((v >> 8) & 255));
    buf[off + 2] := to_byte(to_int((v >> 16) & 255));
    buf[off + 3] := to_byte(to_int((v >> 24) & 255));
    buf[off + 4] := to_byte(to_int((v >> 32) & 255));
    buf[off + 5] := to_byte(to_int((v >> 40) & 255));
    buf[off + 6] := to_byte(to_int((v >> 48) & 255));
    buf[off + 7] := to_byte(to_int((v >> 56) & 255));
    0
}

fn write_u64_be(buf: Ref[byte], off: int, v: u64) -> int {
    buf[off]     := to_byte(to_int((v >> 56) & 255));
    buf[off + 1] := to_byte(to_int((v >> 48) & 255));
    buf[off + 2] := to_byte(to_int((v >> 40) & 255));
    buf[off + 3] := to_byte(to_int((v >> 32) & 255));
    buf[off + 4] := to_byte(to_int((v >> 24) & 255));
    buf[off + 5] := to_byte(to_int((v >> 16) & 255));
    buf[off + 6] := to_byte(to_int((v >> 8) & 255));
    buf[off + 7] := to_byte(to_int(v & 255));
    0
}

// ---------- detect native endianness ----------

fn is_little_endian(r: Region) -> bool {
    let probe = ref(r, [to_byte(1), to_byte(0)]);
    read_u16_le(probe, 0) == 1
}
