// Buf[T] — голый стековый массив. Никаких проверок, размер compile-time.
//
// Под капотом: C-array `int _stor[N]` на стек-фрейме функции плюс
// handle `{ int* ptr; int len }`. Доступ `b[i]` это `b.ptr[i]` — без
// gen check, без bounds check. C-семантика: твоя ответственность.
//
// Использовать когда:
//   - размер известен на compile time (литерал)
//   - не нужна safety (горячий код, или ты уверен)
// Иначе — region + Array.
fn main() -> int {
    // Литерал: значения видны, длина выведена.
    let a = [10, 20, 30, 40, 50];
    // buf(N, init): N литерал, все слоты = init.
    let b = buf(5, 1);
    // Можно писать (без проверок).
    b[2] := 99;
    a[0] + a[4] + b[0] + b[2] + b[4] + len(a) + len(b)
    // 10 + 50 + 1 + 99 + 1 + 5 + 5 = 171
}
