// Debug printing — pure-stdlib helpers, no language sugar required.
//
// Usage:
//   use dbg::{d, i, b};
//   d(r, array(r, ["x=", i(r, x), " y=", i(r, y), " ok=", b(flag)]));
//
// Each value-to-bytes converter has a short name so the call site
// reads close to a printf call without the format-string overhead.

use io::{print};
use str::{concat_all, int_to_bytes};

// `d` — debug-print a list of byte-array fragments, joined.
// Appends a newline so the caller doesn't have to.
fn d(r: Region, parts: Array[Array[byte]]) -> int {
    let _ = print(concat_all(r, parts));
    print("\n")
}

// `i` — render int as decimal bytes.
fn i(r: Region, n: int) -> Array[byte] { int_to_bytes(r, n) }

// `b` — render bool as "true" / "false".
fn b(v: bool) -> Array[byte] { if v { "true" } else { "false" } }
