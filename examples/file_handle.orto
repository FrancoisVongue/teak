// File-handle demo: a real resource.
//
// Shows how a file descriptor wrapped in a `resource struct` behaves:
//   - copying is a compile error (alias forbidden)
//   - forgetting to handle it in one branch is a compile error
//   - it must be consumed explicitly (resources have no auto-drop)
//
// In a real program these `extern fn`s would be from libc. We declare
// the same prototypes here so the C linker resolves them.

extern fn close(fd: int) -> int
extern fn write(fd: int, buf: *byte, n: int) -> int
extern fn putchar(c: int) -> int

resource struct File { fd: int }

// `file_close` is just a by-value consumer the author wrote (any name) —
// calling it moves the File in and ends it. No required drop function.
fn file_close(f: File) -> int {
    close(f.fd);   // release the kernel resource
    0
}

fn open_stdout() -> File {
    File { fd: 1 }
}

// Writing only READS the handle, so it borrows: `&File`. By value it would
// MOVE the file into write_str (F5) and the caller would lose it.
fn write_str(f: &File, s: Handle[byte]) -> int {
    write(f.fd, as_ptr(s), len(s));
    0
}

fn main() -> int {
    let f = open_stdout();
    write_str(&f, "first line\n");
    write_str(&f, "second line\n");

    // We could consume early:
    //   file_close(f);
    //   write_str(&f, "...");  // ← compiler would catch this (use of moved)
    //
    putchar(65);  // 'A'
    putchar(10);
    file_close(f);  // consume via the author's by-value fn (move)
    0
}
