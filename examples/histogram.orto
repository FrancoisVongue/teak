// Histogram + peak — простой пример "среднего уровня" на orto.
//
// Что делаем:
//   - Создаём массив целых чисел (values) явным заполнением.
//   - Создаём массив счётчиков (counters), один слот на каждое возможное
//     значение 0..4.
//   - Проходим values, для каждого values[i] инкрементим counters[values[i]].
//   - Находим максимум в counters — это пиковая частота.
//
// Что под капотом:
//   - Каждый `array(N, init)` это ОДИН malloc на N*sizeof(int)+header.
//   - Wrapper {ptr, gen, len} (24 байта) живёт на стеке функции.
//   - Передача массива в функцию — copy wrapper в регистры/слот аргумента.
//     Программно — move: caller теряет имя, callee владеет.
//   - Возврат массива — copy wrapper в регистр возврата. Callee scope-exit
//     не делает free (массив в tail-позиции). Caller получает ownership.
//   - Каждое a[i] := v и a[i] это gen-check + bounds-check + load/store.
//   - На scope-exit, если массив всё ещё жив (не consumed), компилятор
//     сам вставляет один free(a.ptr). Если ветки расходятся (consumed
//     в одной, нет в другой) — компилятор автоматически вставляет drop
//     в той ветке где не consumed, делая поведение симметричным.

fn main() -> int {
    // Восемь значений: 4, 1, 4, 2, 4, 1, 3, 2. Максимум = 4.
    // malloc №1: один блок на 8*int+header. Все слоты = 0.
    let values = array(8, 0);
    // Восемь записей в buffer. Каждая — bounds+gen check + store.
    let _ = values[0] := 4;
    let _ = values[1] := 1;
    let _ = values[2] := 4;
    let _ = values[3] := 2;
    let _ = values[4] := 4;
    let _ = values[5] := 1;
    let _ = values[6] := 3;
    let _ = values[7] := 2;

    // Счётчики для значений 0..4. malloc №2: 5*int+header, все нули.
    let counters = array(5, 0);

    // build_histogram потребляет values и counters (передача = move).
    // Возвращает counters с инкрементами. После вызова — values мёртв,
    // counters перевязана на новое имя (то же значение, ownership уехал
    // через регистр возврата).
    let counters = build_histogram(values, counters, 0);

    // find_max потребляет counters. Возвращает int. После вызова —
    // counters мёртв. find_max сам сделал free перед возвратом int.
    find_max(counters, 0, 0)
    // Ожидаемое значение: 3 (число 4 встретилось три раза в values).
}

// Проход по values, инкремент counters[values[i]] для каждого i.
// then-ветка consume'ит values и counters через рекурсию.
// else-ветка должна симметризовать: counters уходит через tail,
// а values нужно явно выкинуть через `let _ = values`.
// Каждое use некопируемого имени видно в исходнике; компилятор
// ничего сам не вставляет.
fn build_histogram(values: Array[int], counters: Array[int], i: int)
    -> Array[int] {
    if i < len(values) {
        let v = values[i];
        let _ = counters[v] := counters[v] + 1;
        build_histogram(values, counters, i + 1)
    } else {
        // Явно потребляем values (`let _ = values` для Array компилится
        // в одноразовое связывание с auto-drop → free(_drop_N.ptr)).
        // counters уходит через tail.
        let _ = values;
        counters
    }
}

// Линейный max. Симметрично: counters consume'ется через рекурсию в
// then-ветке, в else-ветке мы вручную выкидываем.
fn find_max(counters: Array[int], i: int, best: int) -> int {
    if i < len(counters) {
        let v = counters[i];
        let new_best = if v > best { v } else { best };
        find_max(counters, i + 1, new_best)
    } else {
        let _ = counters;
        best
    }
}
