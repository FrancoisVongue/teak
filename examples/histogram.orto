// Histogram + peak — пример "среднего уровня" на orto.
//
// Под капотом:
//   - region(N) — один malloc на header + один malloc на N байт буфера.
//     Внутри функции живёт линейная Region (move-only).
//   - array(r, N, init) — bump-allocate в r->buffer. Возвращает Array[T]
//     (handle: 24 байта = ptr на header + offset + len + expected_gen).
//     Array копируемая — можно передавать в функции, копировать в let,
//     возвращать. Это просто числа.
//   - На scope-exit региона: free(r->buffer), gen++. Все Array-handles
//     становятся dangling — следующий доступ через gen-check abort'нет.

fn main() -> int {
    // Одна арена на всё. 4 KB достаточно для двух массивов.
    let r = region(4096);

    // Восемь значений: 4, 1, 4, 2, 4, 1, 3, 2. Максимум = 4.
    let values = array(r, 8, 0);
    values[0] := 4;
    values[1] := 1;
    values[2] := 4;
    values[3] := 2;
    values[4] := 4;
    values[5] := 1;
    values[6] := 3;
    values[7] := 2;

    // Счётчики для значений 0..4.
    let counters = array(r, 5, 0);

    // build_histogram читает values и инкрементит counters. Оба handle
    // копируемые — функции передаются по value, изменения через
    // указатель внутри handle (в буфер региона) видны всем.
    build_histogram(values, counters, 0);

    // find_max просто читает counters.
    find_max(counters, 0, 0)
    // scope-exit r — один free(r->buffer). Всё что в нём — мертво.
}

fn build_histogram(values: Array[int], counters: Array[int], i: int) -> int {
    if i < len(values) {
        let v = values[i];
        counters[v] := counters[v] + 1;
        build_histogram(values, counters, i + 1)
    } else {
        0
    }
}

fn find_max(counters: Array[int], i: int, best: int) -> int {
    if i < len(counters) {
        let v = counters[i];
        let new_best = if v > best { v } else { best };
        find_max(counters, i + 1, new_best)
    } else {
        best
    }
}
