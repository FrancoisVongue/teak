// std::iouring — synchronous façade over Linux io_uring.
//
// io_uring is the modern Linux async I/O interface. Even when we drive
// it synchronously (one-op-submit-wait per call), it has the advantages:
//   - one syscall instead of many for batched workloads
//   - fewer copies in some ops (registered buffers, splice)
//   - the SAME API for file/socket/timer/pipe — no per-domain split
//   - first-class linkat/openat/statx (not all wired up here yet)
//
// This module is the V1: synchronous wrapper. Each operation submits
// one SQE and blocks until the CQE returns. Real concurrency comes
// later when the language gets coroutines / `async fn`.
//
// Build: link with examples/iouring_helpers.c and -luring.
//   cc your_app.c examples/iouring_helpers.c -luring -o your_app
//
// Targets: Linux 5.6+ (modern io_uring). We don't care about older
// kernels, Windows, or macOS.

// ---------- C-side helpers (thin glue over liburing) ----------

pub extern fn orto_ring_create(entries: int) -> *byte
pub extern fn orto_ring_exit(handle: *byte) -> int

pub extern fn orto_ring_read(handle: *byte, fd: int,
                          buf: *byte, len_: int, offset: int) -> int
pub extern fn orto_ring_write(handle: *byte, fd: int,
                           buf: *byte, len_: int, offset: int) -> int
pub extern fn orto_ring_openat(handle: *byte, path: *byte,
                            flags: int, mode: int) -> int
pub extern fn orto_ring_close(handle: *byte, fd: int) -> int
pub extern fn orto_ring_fsync(handle: *byte, fd: int) -> int

pub extern fn orto_ring_socket(handle: *byte,
                            domain: int, type_: int, protocol: int) -> int
pub extern fn orto_ring_connect(handle: *byte, fd: int,
                             addr: *byte, addrlen: int) -> int
pub extern fn orto_ring_accept(handle: *byte, fd: int) -> int
pub extern fn orto_ring_send(handle: *byte, fd: int,
                          buf: *byte, len_: int, flags: int) -> int
pub extern fn orto_ring_recv(handle: *byte, fd: int,
                          buf: *byte, len_: int, flags: int) -> int

// ---------- resource ring handle ----------

pub resource struct Ring { handle: *byte }

pub fn ring_close(r: Ring) -> int {
    orto_ring_exit(r.handle);
    0
}

// Create a ring with capacity for `entries` in-flight ops. Returned
// Ring drops automatically (releases kernel resources). If creation
// fails the inner handle is NULL — the drop is still safe (no-op).
pub fn ring_new(entries: int) -> Ring {
    Ring { handle: orto_ring_create(entries) }
}

pub fn ring_failed(r: &Ring) -> bool { is_null(r.handle) }

// ---------- I/O operations ----------
//
// All ops borrow the ring (don't consume), block, and return the
// io_uring `res`:
//   >= 0  — success, bytes transferred / new fd / etc.
//   < 0   — -errno (negate to get the C errno value).
//
// File descriptors here are plain `int`. Pair with `sys::Fd` to get
// the resource close-at-scope behaviour: wrap with `fd_wrap(raw)`
// after `uring_open`.

pub fn uring_read(r: &Ring, fd: int, buf: Handle[byte], offset: int) -> int {
    orto_ring_read(r.handle, fd, as_ptr(buf), len(buf), offset)
}

pub fn uring_write(r: &Ring, fd: int, buf: Handle[byte], offset: int) -> int {
    orto_ring_write(r.handle, fd, as_ptr(buf), len(buf), offset)
}

pub fn uring_open(r: &Ring, path: Handle[byte], flags: int, mode: int) -> int {
    orto_ring_openat(r.handle, as_ptr(path), flags, mode)
}

pub fn uring_close(r: &Ring, fd: int) -> int {
    orto_ring_close(r.handle, fd)
}

pub fn uring_fsync(r: &Ring, fd: int) -> int {
    orto_ring_fsync(r.handle, fd)
}

// ---------- socket operations ----------

pub fn uring_socket(r: &Ring, domain: int, type_: int, protocol: int) -> int {
    orto_ring_socket(r.handle, domain, type_, protocol)
}

pub fn uring_connect(r: &Ring, fd: int, addr: Handle[byte]) -> int {
    orto_ring_connect(r.handle, fd, as_ptr(addr), len(addr))
}

pub fn uring_accept(r: &Ring, fd: int) -> int {
    orto_ring_accept(r.handle, fd)
}

pub fn uring_send(r: &Ring, fd: int, buf: Handle[byte], flags: int) -> int {
    orto_ring_send(r.handle, fd, as_ptr(buf), len(buf), flags)
}

pub fn uring_recv(r: &Ring, fd: int, buf: Handle[byte], flags: int) -> int {
    orto_ring_recv(r.handle, fd, as_ptr(buf), len(buf), flags)
}

// ---------- Stage 2: queue many ops, drain completions manually ----------

pub extern fn orto_ring_submit_read(handle: *byte, fd: int,
                                 buf: *byte, len_: int, offset: int,
                                 user_data: int) -> int
pub extern fn orto_ring_submit_write(handle: *byte, fd: int,
                                  buf: *byte, len_: int, offset: int,
                                  user_data: int) -> int
pub extern fn orto_ring_submit_send(handle: *byte, fd: int,
                                 buf: *byte, len_: int, flags: int,
                                 user_data: int) -> int
pub extern fn orto_ring_submit_recv(handle: *byte, fd: int,
                                 buf: *byte, len_: int, flags: int,
                                 user_data: int) -> int
pub extern fn orto_ring_flush(handle: *byte) -> int
pub extern fn orto_ring_wait_one(handle: *byte, out_id: *int) -> int
pub extern fn orto_ring_peek_one(handle: *byte, out_id: *int, out_res: *int) -> int

// One I/O completion. `id` is whatever tag the caller assigned to
// the corresponding submit_*; `res` is io_uring's result code.
pub struct Completion {
    id:  int,
    res: int,
}

// Queue a read. `user_data` is your tag — pick any int; you'll see
// it back in `wait_one().id`. Returns 0 on success, -errno if the
// submission queue is full.
pub fn submit_read(r: &Ring, fd: int, buf: Handle[byte], offset: int, id: int) -> int {
    orto_ring_submit_read(r.handle, fd, as_ptr(buf), len(buf), offset, id)
}

pub fn submit_write(r: &Ring, fd: int, buf: Handle[byte], offset: int, id: int) -> int {
    orto_ring_submit_write(r.handle, fd, as_ptr(buf), len(buf), offset, id)
}

pub fn submit_send(r: &Ring, fd: int, buf: Handle[byte], flags: int, id: int) -> int {
    orto_ring_submit_send(r.handle, fd, as_ptr(buf), len(buf), flags, id)
}

pub fn submit_recv(r: &Ring, fd: int, buf: Handle[byte], flags: int, id: int) -> int {
    orto_ring_submit_recv(r.handle, fd, as_ptr(buf), len(buf), flags, id)
}

// Hand the kernel everything we've queued. One syscall regardless of
// how many ops we batched. Returns number of SQEs accepted, -errno
// on failure.
pub fn flush(r: &Ring) -> int {
    orto_ring_flush(r.handle)
}

// Block until one CQE is available. Returns (id, res) as Completion.
pub fn wait_one(r: &Ring) -> Completion {
    let id_buf = c_alloc[int](1);
    let res = orto_ring_wait_one(r.handle, id_buf);
    let id = id_buf[0];
    c_free(id_buf);
    Completion { id: id, res: res }
}

// Try to pick a completion without blocking. Returns None if none
// ready, Some(Completion) if one was consumed.
pub fn try_wait_one(r: &Ring) -> Option[Completion] {
    let id_buf  = c_alloc[int](1);
    let res_buf = c_alloc[int](1);
    let rc = orto_ring_peek_one(r.handle, id_buf, res_buf);
    let result = if rc == 1 {
        Some(Completion { id: id_buf[0], res: res_buf[0] })
    } else {
        None
    };
    c_free(id_buf);
    c_free(res_buf);
    result
}
