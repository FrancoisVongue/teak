// Tiny test of `resource struct` + drop functions.
//
// Pretend Socket — fd is an int but we treat the struct as a resource:
// alias forbidden, scope-exit drop, all reads explicit.

extern fn putchar(c: int) -> int

resource struct Socket { fd: int }

// `close` is just a by-value consumer (any name works) — calling it is a
// move, so it ends the resource. No required drop function.
fn close(s: Socket) -> int {
    // In a real driver this would call libc close(s.fd).
    // Here we just print a marker so we can see drop ran.
    putchar(68);   // 'D'
    putchar(10 + s.fd - s.fd);   // newline; touch s.fd so the field is used
    0
}

fn open_fake() -> Socket {
    Socket { fd: 7 }
}

// Reader: borrows the socket (`&Socket`) — only looks, never consumes, so the
// caller keeps ownership and can use it again. This is F8 (read-only receiver).
fn use_socket(s: &Socket) -> int {
    putchar(85);             // 'U'
    putchar(48 + s.fd);      // '7'
    putchar(10);
    0
}

fn main() -> int {
    let s = open_fake();
    use_socket(&s);          // borrow — s stays alive
    use_socket(&s);          // borrow again — still alive
    close(s);          // by-value = move (F5): consume via the author's fn
    0
}
