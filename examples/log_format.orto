// Application code: takes a "user=alice,age=30,city=NYC" line and
// formats it as ">> ALICE (30) lives in NYC <<".
//
// Strings library lives in str.orto; output helpers in io.orto.
// We pull in just what we need via `use`.

use str::{lookup, to_upper, concat_all, parse_int, int_to_bytes};
// println is an intrinsic

fn format_log(r: Region, input: Handle[byte]) -> Handle[byte] {
    let name = to_upper(r, lookup(input, "user"));
    let age  = int_to_bytes(r, parse_int(lookup(input, "age")));
    let city = lookup(input, "city");
    concat_all(r, ref(r, [">> ", name, " (", age, ") lives in ", city, " <<"]))
}

fn main() -> int {
    arena r = region(4096);
    let line = format_log(r, "user=alice,age=30,city=NYC");
    println(line);
    len(line)
}
