// Application code: takes a "user=alice,age=30,city=NYC" line and
// formats it as ">> ALICE (30) lives in NYC <<".
//
// Strings library lives in str.orto; output helpers in io.orto.
// We pull in just what we need via `use`.

use str::{lookup, to_upper, concat, parse_int, int_to_bytes};
use io::println;

fn format_log(r: Region, input: Array[byte]) -> Array[byte] {
    let name = lookup(input, "user");
    let age  = parse_int(lookup(input, "age"));
    let city = lookup(input, "city");

    let upper_name = to_upper(r, name);
    let age_bytes  = int_to_bytes(r, age);

    let p1 = concat(r, ">> ", upper_name);
    let p2 = concat(r, p1, " (");
    let p3 = concat(r, p2, age_bytes);
    let p4 = concat(r, p3, ") lives in ");
    let p5 = concat(r, p4, city);
    concat(r, p5, " <<")
}

fn main() -> int {
    let r = region(4096);
    let line = format_log(r, "user=alice,age=30,city=NYC");
    println(line);
    len(line)
}
