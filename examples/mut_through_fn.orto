// Pass Ref into a function, it mutates the cell — caller sees change.
// This is how stateful patterns work without globals.

fn bump(r: Ref[int], by: int) -> int {
    let cur = deref(r) ?? 0;
    let _ = r := cur + by;
    cur + by
}

fn main() -> int {
    let counter = ref(100);

    let _ = bump(counter, 5);    // 105
    let _ = bump(counter, 10);   // 115
    let _ = bump(counter, 20);   // 135

    deref(counter) ?? panic()    // 135
}
