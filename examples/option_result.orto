// Built-in Option[T]: Some(T) | None. Result[T] is also built-in
// since Stage 3 phase 7 — used to wrap await results — so the
// hand-rolled flavour here is renamed DivOutcome to avoid clash.

enum DivOutcome {
    Good(int),
    Bad(int),
}

fn safe_div(a: int, b: int) -> DivOutcome {
    if b == 0 {
        Bad(1)
    } else {
        Good(a / b)
    }
}

fn or_zero(o: Option[int]) -> int {
    match o {
        None    => 0,
        Some(x) => x,
    }
}

fn first_positive(a: int, b: int) -> Option[int] {
    if a > 0 {
        Some(a)
    } else {
        if b > 0 {
            Some(b)
        } else {
            None
        }
    }
}

fn main() -> int {
    let r = safe_div(10, 2);
    let v = match r {
        Good(q) => q,
        Bad(_)  => 0,
    };

    let o = first_positive(0 - 1, 7);
    let w = or_zero(o);

    v - w + 13  // 5 - 7 + 13 = 11
}
