// take(x) consumes x. y now owns. y in tail position — not auto-dropped.
// Net result: one cell allocated, never freed (leaks at program exit, but
// OS reclaims). main returns 99 by unwrapping y... but y was returned —
// wait, y is in main, main returns int. Let's test the take consumption.

fn produce() -> int {
    let x = own(77);
    let y = take(x);    // x consumed by take; y is new owner
    unwrap(y)            // y read here (not consumed), y will be freed
}                        // total: 1 allocation, 1 free. OK.

fn main() -> int {
    produce()
}
