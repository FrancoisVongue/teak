// Raw pointers — escape hatch for FFI. Bypasses Region entirely;
// programmer manages malloc/free by hand.
//
// Demonstrates:
//   - c_alloc[T](n) -> *T
//   - p[i], p[i] := v  (no gen/bounds check)
//   - *p deref
//   - is_null + null_ptr[T]()
//   - c_free
//   - as_ptr(a) — view an Handle[T]'s bytes as *T, for libc calls

extern fn putchar(c: int) -> int
// libc write(fd, buf, n) — fd=1 is stdout
extern fn write(fd: int, buf: *byte, n: int) -> int

fn fill(p: *int, i: int, n: int) -> int {
    if i >= n { 0 }
    else { p[i] := i * i; fill(p, i + 1, n) }
}

fn sum(p: *int, i: int, n: int) -> int {
    if i >= n { 0 }
    else { p[i] + sum(p, i + 1, n) }
}

fn main() -> int {
    // 1. Direct heap allocation, manual free.
    let buf = c_alloc[int](5);
    fill(buf, 0, 5);           // 0, 1, 4, 9, 16
    let total = sum(buf, 0, 5); // 30
    let first = *buf;           // 0
    c_free(buf);

    // 2. NULL pointer + check.
    let p: *int = null_ptr[int]();
    let nullness = if is_null(p) { 1 } else { 0 };

    // 3. Hand off Handle[byte] bytes to a libc call via array_data.
    write(1, as_ptr("hi\n"), 3);

    total + first + nullness     // 30 + 0 + 1 = 31
}
