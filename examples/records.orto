// Records: product types. Construction via Name { ... }, access via .field.

struct Point { x: int, y: int }

struct Pair[A, B] { fst: A, snd: B }

struct Bag {
    count: int,
    flag:  bool,
}

// Records inside an ADT — exercises the cross-product.
enum Result[T] {
    Ok(T),
    Err(Point),
}

fn dist_sq(p: Point) -> int {
    p.x * p.x + p.y * p.y
}

fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
    Pair { fst: p.snd, snd: p.fst }
}

fn pick(r: Result[Pair[int, int]]) -> int {
    match r {
        Ok(p)  => p.fst + p.snd,
        Err(q) => q.x + q.y,
    }
}

fn main() -> int {
    let p = Point { x: 3, y: 4 };
    let d = dist_sq(p);                  // 25

    let pq : Pair[int, bool] = Pair { fst: 7, snd: true };
    let sw = swap(pq);
    let a = if sw.fst { sw.snd } else { 0 };  // 7

    let r1 : Result[Pair[int, int]] = Ok(Pair { fst: 10, snd: 20 });
    let r2 : Result[Pair[int, int]] = Err(Point { x: 1, y: 2 });
    let b = pick(r1);                    // 30
    let c = pick(r2);                    // 3

    let bag = Bag { count: 8, flag: false };
    let e = if bag.flag { 100 } else { bag.count };  // 8

    d + a + b + c + e                    // 25 + 7 + 30 + 3 + 8 = 73
}
