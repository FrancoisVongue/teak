// std::str — operations over Array[byte].
//
// Allocating functions take a Region as first argument.
// View functions (eq, find, slice-based) take no Region.

fn bytes_eq(a: Array[byte], b: Array[byte]) -> bool {
    if len(a) != len(b) { false }
    else {
        let mut i = 0;
        while i < len(a) {
            if a[i] != b[i] { break }
            i := i + 1;
        }
        i == len(a)
    }
}

fn index_of(s: Array[byte], c: byte) -> int {
    let mut i = 0;
    while i < len(s) {
        if s[i] == c { break }
        i := i + 1;
    }
    if i == len(s) { 0 - 1 } else { i }
}

fn parse_int(s: Array[byte]) -> int {
    let mut acc = 0;
    let mut i = 0;
    while i < len(s) {
        let n = to_int(s[i]);
        if n < 48 || n > 57 { break }
        acc := acc * 10 + (n - 48);
        i := i + 1;
    }
    acc
}

fn upper_byte(b: byte) -> byte {
    let n = to_int(b);
    if n >= 97 && n <= 122 { to_byte(n - 32) } else { b }
}

fn to_upper(r: Region, s: Array[byte]) -> Array[byte] {
    let dst = array(r, len(s), to_byte(0));
    let mut i = 0;
    while i < len(s) {
        dst[i] := upper_byte(s[i]);
        i := i + 1;
    }
    dst
}

fn copy_into(dst: Array[byte], src: Array[byte], at: int) -> int {
    let mut i = 0;
    while i < len(src) {
        dst[at + i] := src[i];
        i := i + 1;
    }
    0
}

fn concat(r: Region, a: Array[byte], b: Array[byte]) -> Array[byte] {
    let dst = array(r, len(a) + len(b), to_byte(0));
    copy_into(dst, a, 0);
    copy_into(dst, b, len(a));
    dst
}

fn total_len(parts: Array[Array[byte]]) -> int {
    let mut total = 0;
    let mut i = 0;
    while i < len(parts) {
        total := total + len(parts[i]);
        i := i + 1;
    }
    total
}

fn concat_all(r: Region, parts: Array[Array[byte]]) -> Array[byte] {
    let dst = array(r, total_len(parts), to_byte(0));
    let mut at = 0;
    let mut i = 0;
    while i < len(parts) {
        copy_into(dst, parts[i], at);
        at := at + len(parts[i]);
        i := i + 1;
    }
    dst
}

fn digits_count(n: int) -> int {
    let mut count = 1;
    let mut x = n / 10;
    while x > 0 {
        count := count + 1;
        x := x / 10;
    }
    count
}

fn int_to_bytes(r: Region, n: int) -> Array[byte] {
    let k = digits_count(n);
    let dst = array(r, k, to_byte(0));
    let mut pos = k - 1;
    let mut x = n;
    while pos >= 0 {
        dst[pos] := to_byte(48 + (x % 10));
        x := x / 10;
        pos := pos - 1;
    }
    dst
}

// Find "key=VALUE" in a comma-separated string. Returns a slice over
// VALUE (or empty slice if not found). All slicing — no allocation.
fn lookup(s: Array[byte], key: Array[byte]) -> Array[byte] {
    let mut from = 0;
    let mut result = slice(s, 0, 0);
    while from < len(s) {
        if from + len(key) + 1 <= len(s)
           && bytes_eq(slice(s, from, from + len(key)), key)
           && s[from + len(key)] == to_byte(61) {
            let val_start = from + len(key) + 1;
            let rest = slice(s, val_start, len(s));
            let comma = index_of(rest, to_byte(44));
            result := if comma < 0 { rest } else { slice(rest, 0, comma) };
            break
        }
        let rest = slice(s, from, len(s));
        let comma = index_of(rest, to_byte(44));
        if comma < 0 { break }
        from := from + comma + 1;
    }
    result
}
