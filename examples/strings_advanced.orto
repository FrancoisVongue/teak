// Advanced string mechanics:
//   - duplicate literals are deduped (both "hi" share storage)
//   - slice over an Handle[byte] living in a heap region
//   - byte arithmetic via to_int / to_byte round-trip
//   - escape sequences in literal

extern fn putchar(c: int) -> int

fn print_loop(s: Handle[byte], i: int) -> int {
    if i >= len(s) {
        0
    } else {
        putchar(to_int(s[i]));
        print_loop(s, i + 1)
    }
}

// Build "ABCDE" byte-by-byte into a freshly allocated array.
fn write_alphabet(a: Handle[byte], i: int, n: int) -> int {
    if i >= n {
        0
    } else {
        a[i] := to_byte(65 + i);   // 'A' = 65
        write_alphabet(a, i + 1, n)
    }
}

fn main() -> int {
    // Two identical literals — one entry in the static pool.
    let g1 = "hi\n";
    let g2 = "hi\n";
    print_loop(g1, 0);
    print_loop(g2, 0);

    // Allocate Handle[byte] in a heap region, fill, slice, print.
    arena r   = region(64);
    let buf = ref(r, 5, to_byte(0));
    write_alphabet(buf, 0, 5);
    print_loop(buf, 0);             // ABCDE
    putchar(10);

    let mid = slice(buf, 1, 4);     // BCD
    print_loop(mid, 0);
    putchar(10);

    to_int(mid[0])                  // 'B' = 66
}
