// Realistic string code: a tiny log-line formatter.
// Input:  "user=alice,age=30,city=NYC"
// Output: ">> ALICE (30) lives in NYC <<\n"
//
// Demonstrates a chain of string transforms — extract fields by key,
// parse a number, upper-case, concatenate several pieces — all in
// one Region passed through the call chain.
//
// Region is a copyable handle; the creator scope frees it. Functions
// take Region by value and don't free it. The first half here would
// live in `std::str` once we have modules.


// ---------- "stdlib" — library functions over Ref[byte] ----------

fn bytes_eq_loop(a: Ref[byte], b: Ref[byte], i: int) -> bool {
    if i >= len(a) { true }
    else if a[i] == b[i] { bytes_eq_loop(a, b, i + 1) }
    else { false }
}

fn bytes_eq(a: Ref[byte], b: Ref[byte]) -> bool {
    if len(a) == len(b) { bytes_eq_loop(a, b, 0) } else { false }
}

fn index_of_loop(s: Ref[byte], c: byte, i: int) -> int {
    if i >= len(s) { 0 - 1 }
    else if s[i] == c { i }
    else { index_of_loop(s, c, i + 1) }
}

fn index_of(s: Ref[byte], c: byte) -> int {
    index_of_loop(s, c, 0)
}

fn parse_int_loop(s: Ref[byte], i: int, acc: int) -> int {
    if i >= len(s) { acc }
    else {
        let n = to_int(s[i]);
        if n >= 48 && n <= 57 {
            parse_int_loop(s, i + 1, acc * 10 + (n - 48))
        } else { acc }
    }
}

fn parse_int(s: Ref[byte]) -> int { parse_int_loop(s, 0, 0) }

fn upper_byte(b: byte) -> byte {
    let n = to_int(b);
    if n >= 97 && n <= 122 { to_byte(n - 32) } else { b }
}

fn to_upper_loop(src: Ref[byte], dst: Ref[byte], i: int) -> int {
    if i >= len(src) { 0 }
    else { dst[i] := upper_byte(src[i]); to_upper_loop(src, dst, i + 1) }
}

fn to_upper(r: Region, s: Ref[byte]) -> Ref[byte] {
    let dst = ref(r, len(s), to_byte(0));
    to_upper_loop(s, dst, 0);
    dst
}

fn copy_into(dst: Ref[byte], src: Ref[byte], at: int, i: int) -> int {
    if i >= len(src) { 0 }
    else { dst[at + i] := src[i]; copy_into(dst, src, at, i + 1) }
}

fn concat(r: Region, a: Ref[byte], b: Ref[byte]) -> Ref[byte] {
    let dst = ref(r, len(a) + len(b), to_byte(0));
    copy_into(dst, a, 0, 0);
    copy_into(dst, b, len(a), 0);
    dst
}

fn digits_count(n: int) -> int {
    if n < 10 { 1 } else { 1 + digits_count(n / 10) }
}

fn write_digits(dst: Ref[byte], n: int, pos: int) -> int {
    if n < 10 { dst[pos] := to_byte(48 + n); 0 }
    else {
        dst[pos] := to_byte(48 + (n % 10));
        write_digits(dst, n / 10, pos - 1)
    }
}

fn int_to_bytes(r: Region, n: int) -> Ref[byte] {
    let k = digits_count(n);
    let dst = ref(r, k, to_byte(0));
    write_digits(dst, n, k - 1);
    dst
}

// Find "key=VALUE" in a comma-separated string starting at `from`.
// Returns a slice over VALUE. Empty slice if not found.
// All slicing — no allocation, the result lives in the input's region.
fn field_after(s: Ref[byte], key: Ref[byte], from: int) -> Ref[byte] {
    if from >= len(s) {
        slice(s, 0, 0)
    } else if from + len(key) + 1 <= len(s)
              && bytes_eq(slice(s, from, from + len(key)), key)
              && s[from + len(key)] == to_byte(61) {   // '=' = 61
        let val_start = from + len(key) + 1;
        let rest = slice(s, val_start, len(s));
        let comma = index_of(rest, to_byte(44));        // ',' = 44
        if comma == 0 - 1 { rest } else { slice(rest, 0, comma) }
    } else {
        let rest = slice(s, from, len(s));
        let comma = index_of(rest, to_byte(44));
        if comma == 0 - 1 { slice(s, 0, 0) }
        else { field_after(s, key, from + comma + 1) }
    }
}

fn lookup(s: Ref[byte], key: Ref[byte]) -> Ref[byte] {
    field_after(s, key, 0)
}

// ---------- application code ----------
//
// Output uses the `println` language intrinsic (one writev syscall);
// no putchar-loop helper needed.

// Build ">> ALICE (30) lives in NYC <<" from "user=alice,age=30,city=NYC".
fn format_log(r: Region, input: Ref[byte]) -> Ref[byte] {
    let name = lookup(input, "user");
    let age  = parse_int(lookup(input, "age"));
    let city = lookup(input, "city");

    let upper_name = to_upper(r, name);
    let age_bytes  = int_to_bytes(r, age);

    let p1 = concat(r, ">> ", upper_name);
    let p2 = concat(r, p1, " (");
    let p3 = concat(r, p2, age_bytes);
    let p4 = concat(r, p3, ") lives in ");
    let p5 = concat(r, p4, city);
    concat(r, p5, " <<")
}

fn main() -> int {
    arena r = region(4096);
    let line = format_log(r, "user=alice,age=30,city=NYC");
    println(line);
    len(line)
}
