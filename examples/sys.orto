// std::sys — thin layer over libc system calls.
//
// File / socket descriptors are wrapped in a `resource struct Fd` so the
// compiler ensures you can't accidentally clone, alias, or forget to
// close them. The underlying syscalls are accessed via plain `extern
// fn` declarations — that's the "through-hole" to libc, no language
// magic needed.
//
// Most byte buffers passed to syscalls live in a user-allocated Region
// (so Handle[byte] is the natural type). `as_ptr(buf)` converts to
// `*byte` at the call site.

// ---------- libc syscalls and helpers ----------

pub extern fn open(path: *byte, flags: int, mode: int) -> int
pub extern fn close(fd: int) -> int
pub extern fn read(fd: int, buf: *byte, n: int) -> int
pub extern fn write(fd: int, buf: *byte, n: int) -> int
pub extern fn lseek(fd: int, offset: int, whence: int) -> int

pub extern fn socket(domain: int, type_: int, protocol: int) -> int
pub extern fn bind(fd: int, addr: *byte, addrlen: int) -> int
pub extern fn listen(fd: int, backlog: int) -> int
pub extern fn accept(fd: int, addr: *byte, addrlen: *int) -> int
pub extern fn connect(fd: int, addr: *byte, addrlen: int) -> int
pub extern fn sendto(fd: int, buf: *byte, n: int, flags: int,
                 addr: *byte, addrlen: int) -> int
pub extern fn recvfrom(fd: int, buf: *byte, n: int, flags: int,
                   addr: *byte, addrlen: *int) -> int

pub extern fn getpid() -> int

// errno as a function (libc usually exposes it via __errno_location).
pub extern fn __errno_location() -> *int
pub fn errno() -> int { *__errno_location() }

// ---------- common flag constants ----------

// Constants are lowercase fns (orto parses CapitalCase as ctor names).
pub fn o_rdonly()   -> int { 0      }
pub fn o_wronly()   -> int { 1      }
pub fn o_rdwr()     -> int { 2      }
pub fn o_creat()    -> int { 64     }   // 0o100
pub fn o_trunc()    -> int { 512    }   // 0o1000
pub fn o_append()   -> int { 1024   }   // 0o2000

pub fn af_unix()    -> int { 1      }
pub fn af_inet()    -> int { 2      }
pub fn af_netlink() -> int { 16     }
pub fn sock_dgram()  -> int { 2     }
pub fn sock_stream() -> int { 1     }
pub fn sock_raw()    -> int { 3     }

pub fn seek_set() -> int { 0 }
pub fn seek_cur() -> int { 1 }
pub fn seek_end() -> int { 2 }

// ---------- resource file/socket descriptor ----------

pub resource struct Fd { raw: int }

pub fn fd_close(f: Fd) -> int { close(f.raw); 0 }

// fd_wrap takes a raw int from libc and wraps it in a Fd, asserting
// it's a real descriptor. Use after checking raw >= 0.
pub fn fd_wrap(raw: int) -> Fd { Fd { raw: raw } }

// Low-level openers — return the raw fd (-1 on error). Wrap into a
// Fd at the call site once you've verified raw >= 0; this keeps the
// resource-owning type out of generic Option[T].
//
//     let raw = sys_open(path, flags, mode);
//     if raw < 0 { return error_path(raw) }
//     let f = fd_wrap(raw);
//     // f drops automatically at scope end
//
// The pattern is a couple of lines and totally explicit; the
// alternative would be a custom `resource enum FdResult` per-call,
// which is more boilerplate for the same effect.

pub fn sys_open(path: Handle[byte], flags: int, mode: int) -> int {
    open(as_ptr(path), flags, mode)
}

pub fn sys_socket(domain: int, type_: int, protocol: int) -> int {
    socket(domain, type_, protocol)
}

// Borrow operations on Fd (`&Fd`) — read only, the descriptor stays alive and
// the caller keeps ownership. By value these would MOVE the Fd in and close it.
pub fn fd_read(f: &Fd, buf: Handle[byte]) -> int {
    read(f.raw, as_ptr(buf), len(buf))
}

pub fn fd_write(f: &Fd, buf: Handle[byte]) -> int {
    write(f.raw, as_ptr(buf), len(buf))
}

pub fn fd_seek(f: &Fd, offset: int, whence: int) -> int {
    lseek(f.raw, offset, whence)
}
