// The unit type `()` — the empty tuple, the value of "nothing".
// Effectful expressions (`:=`, `while`, `for`, `print`, an `if` without
// `else`) evaluate to `()`. A function that only does something returns
// `()`. An `if` without `else` is a statement: it runs its body for
// effect, discards the body's value, and yields `()`.

fn bump(r: Ref[int], i: int) -> () {
    r[i] := r[i] + 1;
}

fn classify(x: int) -> int {
    let mut tag = 0;
    if x > 10  { tag := 2; }      // if without else — a statement, yields ()
    if x > 100 { tag := 3; }
    tag
}

fn first_big(xs: Ref[int]) -> int {
    let mut i = 0;
    while i < len(xs) {
        if xs[i] > 50 { return xs[i]; }   // return inside an if-without-else
        i := i + 1;
    }
    0
}

fn main() -> int {
    arena r = region(256);
    let xs = ref(r, [3, 60, 200]);
    bump(xs, 0);              // xs[0] = 4
    let u: () = ();           // the unit value, written explicitly
    let _ = u;
    classify(5) + classify(150) + first_big(xs) + xs[0]   // 0 + 3 + 60 + 4 = 67
}
