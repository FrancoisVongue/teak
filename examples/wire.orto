// Wire-format I/O: packed struct overlay + the std::raw unsafe codec.
//
// `packed struct` has no padding, so ptr_cast overlay matches a byte
// layout exactly. std::raw gives host-independent byte-assembly codecs
// over raw *byte (foreign buffers, mmap, packets).

use raw::{write_u32_be, read_u32_be, write_u16_be, read_u16_be};

// Packed: 1 + 4 = 5 bytes. Unpacked, C would pad `a` out to 8 bytes
// (b at offset 4). We prove the difference below.
packed struct P { a: byte, b: u32 }

fn main() -> int {
    let buf = c_alloc[byte](16);
    let mut i = 0;
    while i < 16 { buf[i] := to_byte(0); i := i + 1; }

    // Zero-copy overlay write of a whole struct onto raw bytes.
    let hp = ptr_cast[P](buf);
    hp[0] := P { a: to_byte(7), b: to_u32(16909060) };   // 0x01020304

    // PROOF of packed: b occupies bytes [1..4], so byte[1] is part of b
    // (nonzero). With C padding, byte[1] would be padding -> 0.
    let at1 = to_int(buf[1]);
    let packed_ok = if at1 != 0 { 1 } else { 0 };

    let a_field = to_int(buf[0]);            // 7

    // Exercise the raw BE byte-codec on the same buffer (host-independent).
    write_u32_be(buf, 8, 168496141);         // 0x0A0B0C0D
    write_u16_be(buf, 12, 4660);             // 0x1234
    let back32 = read_u32_be(buf, 8);
    let back16 = read_u16_be(buf, 12);
    let codec_ok =
        if back32 == 168496141 { if back16 == 4660 { 1 } else { 0 } } else { 0 };

    c_free(buf);

    a_field + packed_ok + codec_ok           // 7 + 1 + 1 = 9
}
