// std/math.orto — integer and pure-float math. No allocation, no FFI.
//
// Two families, named apart (orto has no overloading, by design): the
// plain names work on `int`, the `f`-prefixed ones on `float`. Only
// functions implementable without libm live here; transcendentals
// (sin/cos/exp/log) belong to a future float module over the FFI
// escape hatch, because they genuinely need libm — not laziness.

// ---------- integer ----------

pub fn min(a: int, b: int) -> int { if a < b { a } else { b } }
pub fn max(a: int, b: int) -> int { if a > b { a } else { b } }
pub fn abs(a: int) -> int { if a < 0 { 0 - a } else { a } }
pub fn sign(a: int) -> int { if a < 0 { 0 - 1 } else { if a > 0 { 1 } else { 0 } } }

pub fn clamp(x: int, lo: int, hi: int) -> int {
    if x < lo { lo } else { if x > hi { hi } else { x } }
}

pub fn pow(base: int, exp: int) -> int {
    let mut acc = 1;
    let mut b = base;
    let mut e = exp;
    while e > 0 {
        if (e & 1) == 1 { acc := acc * b; }    // exponentiation by squaring
        b := b * b;
        e := e >> 1;
    }
    acc
}

pub fn gcd(a: int, b: int) -> int {
    let mut x = abs(a);
    let mut y = abs(b);
    while y != 0 {
        let t = y;
        y := x % y;
        x := t;
    }
    x
}

pub fn lcm(a: int, b: int) -> int {
    if a == 0 { 0 } else { if b == 0 { 0 } else { abs(a) / gcd(a, b) * abs(b) } }
}

// floor(sqrt(n)) for n >= 0, exact (integer Newton's method).
pub fn isqrt(n: int) -> int {
    if n < 2 {
        if n < 0 { 0 } else { n }
    } else {
        let mut x = n;
        let mut y = (x + 1) / 2;
        while y < x {
            x := y;
            y := (x + n / x) / 2;
        }
        x
    }
}

// floor(log2(n)) for n >= 1; 0 for n <= 1.
pub fn ilog2(n: int) -> int {
    let mut x = n;
    let mut r = 0;
    while x > 1 { x := x >> 1; r := r + 1; }
    r
}

pub fn is_pow2(n: int) -> bool { n > 0 && (n & (n - 1)) == 0 }

// Smallest power of two >= n (>= 1 always).
pub fn next_pow2(n: int) -> int {
    let mut p = 1;
    while p < n { p := p << 1; }
    p
}

pub fn factorial(n: int) -> int {
    let mut acc = 1;
    let mut i = 2;
    while i <= n { acc := acc * i; i := i + 1; }
    acc
}

// ---------- float ----------

pub fn fabs(a: float) -> float { if a < 0.0 { 0.0 - a } else { a } }
pub fn fmin(a: float, b: float) -> float { if a < b { a } else { b } }
pub fn fmax(a: float, b: float) -> float { if a > b { a } else { b } }

// Truncate toward zero.
pub fn ftrunc(x: float) -> float { to_float(to_int(x)) }

pub fn ffloor(x: float) -> float {
    let t = ftrunc(x);
    if x < t { t - 1.0 } else { t }
}

pub fn fceil(x: float) -> float {
    let t = ftrunc(x);
    if x > t { t + 1.0 } else { t }
}

// Round half away from zero.
pub fn fround(x: float) -> float {
    if x < 0.0 { fceil(x - 0.5) } else { ffloor(x + 0.5) }
}

// sqrt via Newton-Raphson; 0 for x <= 0. Converges to double precision.
pub fn fsqrt(x: float) -> float {
    if x <= 0.0 {
        0.0
    } else {
        let mut g = x;
        let mut i = 0;
        while i < 60 {
            g := (g + x / g) * 0.5;
            i := i + 1;
        }
        g
    }
}
