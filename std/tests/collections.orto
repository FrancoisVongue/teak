use vec::{Vec};
use map::{Map};
use ring::{Ring};
use set::{make};
use sort::{sort};
use math::{max};

fn add(acc: int, x: int) -> int { acc + x }
fn cmp_int(a: int, b: int) -> int { a - b }
fn hash_int(k: int) -> int { k * 2654435761 }
fn eq_int(a: int, b: int) -> bool { a == b }

fn main() -> int {
    arena r = region(65536);

    let mut v = vec::new(r, 2, 0);
    let mut i = 0;
    while i < 10 { v := vec::push(v, r, i); i := i + 1; }
    let vsum = vec::fold(v, 0, add);                 // 45

    let xs = ref(r, [5, 2, 8, 1, 9, 3]);
    sort::sort(xs, cmp_int);                          // [1,2,3,5,8,9]

    let mut m = map::new(r, 4, 0, 0, hash_int, eq_int);
    let mut j = 0;
    while j < 20 { m := map::insert(m, r, j, j * j); j := j + 1; }
    let mget = match map::get(m, 6) { Some(x) => x, None => -1 };   // 36

    let mut s = set::make(r, 4, 0, hash_int, eq_int);
    s := set::add(s, r, 1);
    s := set::add(s, r, 2);
    s := set::add(s, r, 1);                           // dup
    let shas = if set::has(s, 2) { 1 } else { 0 };    // 1

    let mut rg = ring::new(r, 3, 0);
    rg := ring::push(rg, 10);
    rg := ring::push(rg, 20);
    rg := ring::push(rg, 30);
    rg := ring::push(rg, 40);                         // [20,30,40]
    rg := ring::push(rg, 50);                         // [30,40,50]
    let (rg2, p1) = ring::pop(rg);                    // 30
    let pv = match p1 { Some(x) => x, None => -1 };

    vsum + xs[0] + xs[5] + mget + shas + pv + max(7, 4)
    // 45 + 1 + 9 + 36 + 1 + 30 + 7 = 129
}
