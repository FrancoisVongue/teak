// Regression test for the collection modules. Each passing check adds 1
// to the score; main returns the total so the runner can compare it.

use std::vec::{Vec};
use std::map::{Map};
use std::set::{make};
use std::ring::{Ring};
use std::sort::{sort};
use std::math::{max};

fn add(acc: int, x: int) -> int { acc + x }
fn dbl(x: int) -> int { x * 2 }
fn even(x: int) -> bool { x % 2 == 0 }
fn eqi(a: int, b: int) -> bool { a == b }
fn cmp_int(a: int, b: int) -> int { a - b }
fn hash_int(k: int) -> int { k * 2654435761 }

fn check_vec(r: Region) -> int {
    let mut v = std::vec::new(r, 2, 0);
    let mut i = 0;
    while i < 10 { v := std::vec::push(v, r, i); i := i + 1; }       // [0..9]
    let mut s = 0;
    if std::vec::size(v) == 10 { s := s + 1; }
    if std::vec::fold(v, 0, add) == 45 { s := s + 1; }
    if std::vec::get(v, 3) == 3 { s := s + 1; }
    let m = std::vec::map(v, r, dbl, 0);
    if std::vec::get(m, 9) == 18 { s := s + 1; }
    let f = std::vec::filter(v, r, even);
    if std::vec::size(f) == 5 { s := s + 1; }
    if std::vec::any(v, even) && std::vec::all(m, even) { s := s + 1; }
    if std::vec::index_of(v, 7, eqi) == 7 && std::vec::contains(v, 4, eqi) { s := s + 1; }
    std::vec::reverse(v);
    if std::vec::get(v, 0) == 9 { s := s + 1; }
    let iv = std::vec::insert_at(v, r, 0, 100);
    if std::vec::get(iv, 0) == 100 { s := s + 1; }
    let rv = std::vec::remove_at(iv, 0);
    if std::vec::get(rv, 0) == 9 { s := s + 1; }
    let (pv, _) = std::vec::pop(rv);
    if std::vec::size(pv) == 9 { s := s + 1; }
    match std::vec::last(rv) { Some(x) => if x == 0 { s := s + 1; }, None => (), }
    s                                                           // 12
}

fn check_sort(r: Region) -> int {
    let xs = ref(r, [5, 2, 8, 1, 9, 3, 7, 4, 6, 0]);
    std::sort::sort(xs, cmp_int);
    let mut s = 0;
    if std::sort::is_sorted(xs, cmp_int) { s := s + 1; }
    if xs[0] == 0 && xs[9] == 9 { s := s + 1; }
    if std::sort::bsearch(xs, 6, cmp_int) == 6 { s := s + 1; }
    if std::sort::lower_bound(xs, 6, cmp_int) == 6 { s := s + 1; }
    s                                                           // 4
}

fn check_map(r: Region) -> int {
    let mut m = std::map::new(r, 4, 0, 0, hash_int, eqi);
    let mut j = 0;
    while j < 30 { m := std::map::insert(m, r, j, j * j); j := j + 1; }   // forces grows
    let mut s = 0;
    if std::map::size(m) == 30 { s := s + 1; }
    match std::map::get(m, 6) { Some(x) => if x == 36 { s := s + 1; }, None => (), }
    if std::map::contains(m, 29) && !std::map::contains(m, 99) { s := s + 1; }
    if std::map::get_or(m, 99, 0 - 1) == 0 - 1 { s := s + 1; }
    m := std::map::remove(m, 6);
    if !std::map::contains(m, 6) && std::map::size(m) == 29 { s := s + 1; }
    m := std::map::insert(m, r, 6, 7);                                  // reuse tombstone
    match std::map::get(m, 6) { Some(x) => if x == 7 { s := s + 1; }, None => (), }
    if std::vec::size(std::map::keys(m, r, 0)) == 30 { s := s + 1; }
    s                                                           // 7
}

fn check_set(r: Region) -> int {
    let mut a = std::set::make(r, 4, 0, hash_int, eqi);
    let mut b = std::set::make(r, 4, 0, hash_int, eqi);
    let mut i = 0;
    while i < 10 { a := std::set::add(a, r, i); i := i + 1; }        // {0..9}
    i := 5;
    while i < 15 { b := std::set::add(b, r, i); i := i + 1; }        // {5..14}
    let mut s = 0;
    if std::set::size(a) == 10 && std::set::has(a, 7) { s := s + 1; }
    if std::set::size(std::set::union(r, a, b)) == 15 { s := s + 1; }
    if std::set::size(std::set::intersect(r, a, b)) == 5 { s := s + 1; }
    if std::set::size(std::set::difference(r, a, b)) == 5 { s := s + 1; }
    s                                                           // 4
}

fn check_ring(r: Region) -> int {
    let mut q = std::ring::new(r, 3, 0);
    q := std::ring::push(q, 10);
    q := std::ring::push(q, 20);
    q := std::ring::push(q, 30);
    q := std::ring::push(q, 40);                                      // [20,30,40]
    let mut s = 0;
    if std::ring::is_full(q) && std::ring::size(q) == 3 { s := s + 1; }
    match std::ring::peek(q) { Some(x) => if x == 20 { s := s + 1; }, None => (), }
    let (q2, p) = std::ring::pop(q);
    match p { Some(x) => if x == 20 { s := s + 1; }, None => (), }
    if std::ring::size(q2) == 2 { s := s + 1; }
    s                                                           // 4
}

fn check_math() -> int {
    let mut s = 0;
    if std::math::isqrt(144) == 12 { s := s + 1; }
    if std::math::pow(2, 10) == 1024 { s := s + 1; }
    if std::math::gcd(48, 36) == 12 && std::math::lcm(4, 6) == 12 { s := s + 1; }
    if std::math::next_pow2(100) == 128 && std::math::is_pow2(64) { s := s + 1; }
    if std::math::ilog2(1024) == 10 { s := s + 1; }
    if to_int(std::math::fsqrt(81.0)) == 9 { s := s + 1; }
    if max(7, 4) == 7 { s := s + 1; }
    s                                                           // 7
}

fn main() -> int {
    arena r = region(262144);
    check_vec(r) + check_sort(r) + check_map(r)
        + check_set(r) + check_ring(r) + check_math()
    // 12 + 4 + 7 + 4 + 4 + 7 = 38
}
