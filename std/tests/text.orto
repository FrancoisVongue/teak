// Regression test for str + fmt. Each passing check adds 1 to the score.

use std::str::{eq, compare, concat, dup, find, contains, starts_with, ends_with, count, trim, to_upper, to_lower, from_int, parse_int, repeat, reverse, replace, index_of, last_index_of, split, join, hash, is_empty};
use std::vec::{Vec, get, slice_of};
use std::fmt::{format};

fn check_str(r: Region) -> int {
    let mut s = 0;
    if std::str::eq("abc", "abc") && !std::str::eq("abc", "abd") { s := s + 1; }
    if std::str::compare("abc", "abd") < 0 && std::str::compare("b", "a") > 0 { s := s + 1; }
    if std::str::find("hello world", "world") == 6 && std::str::find("abc", "z") == 0 - 1 { s := s + 1; }
    if std::str::contains("hello", "ell") { s := s + 1; }
    if std::str::starts_with("hello", "he") && std::str::ends_with("hello", "lo") { s := s + 1; }
    if std::str::count("aXaXaX", "a") == 3 { s := s + 1; }
    if std::str::eq(std::str::trim("  hi  "), "hi") { s := s + 1; }
    if std::str::eq(std::str::to_upper(r, "abc"), "ABC") && std::str::eq(std::str::to_lower(r, "ABC"), "abc") { s := s + 1; }
    if std::str::eq(std::str::from_int(r, 0 - 42), "-42") && std::str::eq(std::str::from_int(r, 0), "0") { s := s + 1; }
    match std::str::parse_int("123") { Some(n) => if n == 123 { s := s + 1; }, None => (), }
    match std::str::parse_int("-7") { Some(n) => if n == 0 - 7 { s := s + 1; }, None => (), }
    match std::str::parse_int("xy") { Some(_) => (), None => s := s + 1, }
    if std::str::eq(std::str::repeat(r, "ab", 3), "ababab") { s := s + 1; }
    if std::str::eq(std::str::reverse(r, "abc"), "cba") { s := s + 1; }
    if std::str::eq(std::str::replace(r, "a.b.c", ".", "-"), "a-b-c") { s := s + 1; }
    if std::str::eq(std::str::concat(r, "foo", "bar"), "foobar") { s := s + 1; }
    if std::str::index_of("hello", 108) == 2 && std::str::last_index_of("hello", 108) == 3 { s := s + 1; }
    if is_empty("") && !is_empty("x") { s := s + 1; }
    if std::str::hash("abc") == std::str::hash("abc") && std::str::hash("abc") != std::str::hash("abd") { s := s + 1; }
    s                                                           // 19
}

fn check_split_join(r: Region) -> int {
    let mut s = 0;
    let parts = std::str::split(r, "a,b,c", 44);                     // ','
    if std::vec::get(parts, 0)[0] == to_byte(97) && std::vec::get(parts, 2)[0] == to_byte(99) { s := s + 1; }
    let joined = std::str::join(r, std::vec::slice_of(parts), "-");
    if std::str::eq(joined, "a-b-c") { s := s + 1; }
    s                                                           // 2
}

fn check_fmt(r: Region) -> int {
    let mut s = 0;
    let parts = ref(r, [std::str::from_int(r, 7), std::str::concat(r, "x", "y")]);
    let out = format(r, "[{}|{}]", parts);                      // "[7|xy]"
    if std::str::eq(out, "[7|xy]") { s := s + 1; }
    let lit = format(r, "{{not}}", ref(r, [std::str::from_int(r, 0)]));  // "{not}"
    if std::str::eq(lit, "{not}") { s := s + 1; }
    s                                                           // 2
}

fn main() -> int {
    arena r = region(65536);
    check_str(r) + check_split_join(r) + check_fmt(r)
    // 19 + 2 + 2 = 23
}
