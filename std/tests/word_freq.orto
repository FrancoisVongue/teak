// word_freq.orto — top-N word frequencies. Exercises most of the standard
// library at once: str (tokenize), map (count), vec (collect), sort (rank),
// math (clamp the N). Output goes through the `println` intrinsic, which
// renders ints itself on the stack and needs no region at all.

use std::map::{Map};
use std::vec::{Vec};
use std::sort::{sort};
use std::str::{split, hash, eq};
use std::math::{min};

struct WC { word: Handle[byte], n: int }

fn by_count(a: WC, b: WC) -> int { b.n - a.n }   // descending by count

fn main() -> int {
    arena r = region(262144);
    let text = "the quick brown fox the lazy dog the fox jumps the dog";

    // 1. tokenize on spaces -> Vec[Handle[byte]]
    let words = std::str::split(r, text, 32);

    // 2. count occurrences in a Map[Handle[byte], int]; behaviour injected.
    let mut counts = std::map::new(r, 16, "", 0, std::str::hash, std::str::eq);
    let mut i = 0;
    while i < std::vec::size(words) {
        let w = std::vec::get(words, i);
        counts := std::map::insert(counts, r, w, std::map::get_or(counts, w, 0) + 1);
        i := i + 1;
    }

    // 3. move (word, count) pairs into a vec so we can sort them
    let ks = std::map::keys(counts, r, "");
    let mut pairs = std::vec::new(r, std::vec::size(ks), WC { word: "", n: 0 });
    i := 0;
    while i < std::vec::size(ks) {
        let w = std::vec::get(ks, i);
        pairs := std::vec::push(pairs, r, WC { word: w, n: std::map::get_or(counts, w, 0) });
        i := i + 1;
    }

    // 4. rank by frequency, descending
    std::sort::sort(std::vec::slice_of(pairs), by_count);

    // 5. render the top few — no region: println renders the int itself
    let top = std::math::min(3, std::vec::size(pairs));
    i := 0;
    while i < top {
        let p = std::vec::get(pairs, i);
        println((p.word, " -> ", p.n));
        i := i + 1;
    }

    // highest count, as a sanity return value
    std::vec::get(pairs, 0).n
}
